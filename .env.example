# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Ollama Configuration (Local LLM & Embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:14b
OLLAMA_FALLBACK_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=2560

# Generic LLM Provider (ollama | openai)
# Use "openai" for OpenAI-compatible endpoints such as opencode-llm-proxy.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
LLM_FALLBACK_MODEL=qwen2.5:7b

# OpenAI-compatible endpoint configuration
# Defaults point to the opencode-llm-proxy started by OpenCode.
# For OpenCode Go Qwen models (good at Arabic):
#   LLM_PROVIDER=openai
#   LLM_MODEL=opencode-go/qwen3.7-max
#   LLM_FALLBACK_MODEL=opencode-go/qwen3.7-plus
# For OpenAI direct API:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=http://localhost:4010/v1
OPENAI_API_KEY=unused

# Scraping Configuration
QANOON_BASE_URL=https://qanoon.om
REQUEST_DELAY_MIN=0.2
REQUEST_DELAY_MAX=0.7
MAX_RETRIES=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Search Configuration
TOP_K_CANDIDATES=50
TOP_K_FINAL=5
TOPIC_MERGE_THRESHOLD=0.88

# Topic extraction batching (speed up by processing multiple docs per LLM prompt)
TOPIC_BATCH_SIZE=5
TOPIC_BATCH_MAX_CHARS=4000

# Logging
LOG_LEVEL=INFO
